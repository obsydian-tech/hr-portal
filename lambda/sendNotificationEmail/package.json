{
  "name": "send-notification-email-lambda",
  "version": "1.0.0",
  "description": "Lambda: send document lifecycle and onboarding completion emails via Postmark",
  "type": "module",
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.18.0",
    "@aws-lambda-powertools/tracer": "^2.18.0",
    "postmark": "^4.0.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "@aws-sdk/client-dynamodb": "^3.0.0"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest --no-coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/?(*.)+(spec|test).[jt]s?(x)",
      "**/?(*.)+(spec|test).mjs"
    ]
  }
