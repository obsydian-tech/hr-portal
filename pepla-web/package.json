{
  "name": "pepla-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "design-system:sync": "node scripts/design-system-sync.mjs",
    "verify:design": "node scripts/verify-design.mjs",
    "test:design": "node --test scripts/verify-design.test.mjs",
    "prebuild": "npm run verify:design",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:design && ng test --watch=false",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:help": "HELP_SHOTS=1 playwright test -c e2e/playwright.config.ts"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/aria": "22.2.7",
    "@angular/cdk": "22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "lucide": "^1.39.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "1.63.0",
    "jsdom": "^30.0.0",
    "linkedom": "^0.18.5",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
