  },
  "summary": "AI-generated plain-English summary of a verification result",
  "tags": [
   "Verifications"
  ]
 },
 "PATCH /v1/verifications/{id}/review": {
  "description": "HR only. PASSED: approves the document (ocr_status set to PASSED).\nFAILED: rejects it (ocr_status set to FAILED, can_reupload set to true).\nA document is decided once: the decision is one conditional write that records HR's name and the time,\nand a second decision, or a decision while the document is still being read, gets 409.\n`document.reviewed` carries decided_by, decided_by_name, decided_at and actor HUMAN.\nAuto-promotion: when every required document is accepted, the employee stage advances to VERIFIED\n(once per person). The newest read copy of each required type decides; optional documents never\ndecide it, either way.\n",
  "operationId": "reviewVerification",
  "parameters": [
   {
    "in": "path",
    "name": "id",
    "required": true,
    "schema": {
     "type": "string"
    }
   }
  ],
  "requestBody": {
   "content": {
    "application/json": {
     "schema": {
      "$ref": "#/components/schemas/ReviewRequest"
     }
    }
   },
   "required": true
  },
  "responses": {
   "200": {
    "content": {
     "application/json": {
      "schema": {
       "properties": {
        "all_documents_passed": {
         "description": "True when every required document is accepted by HR (the newest read copy of each required\ntype). Optional documents are not looked at.\n",
         "type": "boolean"
        },
        "can_reupload": {
         "type": "boolean"
        },
        "decision": {
         "enum": [
          "PASSED",
          "FAILED"
         ],
         "type": "string"
        },
        "document_id": {
         "type": "string"
        },
        "employee_id": {
         "type": "string"
        },
        "employee_stage_updated": {
         "description": "True if every required document was accepted and the employee was promoted to VERIFIED.",
         "type": "boolean"
        },
        "hr_decided_at": {
         "format": "date-time",
         "type": "string"
        },
        "hr_decided_by_name": {
         "type": "string"
        },
        "hr_decision": {
         "enum": [
          "ACCEPTED",
          "NEW_ONE_ASKED"
         ],
         "type": "string"
        },
        "hr_decision_reason": {
         "nullable": true,
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "required_documents": {
         "description": "The required document types used for this decision.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "required_missing": {
         "description": "Required document types not yet accepted, in the order of required_documents.",
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "type": "object"
      }
     }
    },
    "description": "Review recorded."
   },
   "400": {
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    },
    "description": "Invalid decision value, or the reason is longer than 500 characters."
   },
   "403": {
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    },
    "description": "Only HR can decide on a document."
   },
   "404": {
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    },
    "description": "Verification not found."
   },
   "409": {
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    },
    "description": "This document was already decided or is still being read. Nothing was written."
   }
  },
  "summary": "HR officer approves or rejects a document in manual review",
  "tags": [
   "Verifications"
  ]
 },
 "POST /v1/employees": {
  "description": "Creates an employee record in DynamoDB, provisions a Cognito account with\na temporary password, and sends a welcome email via Postmark.\nEmployee created in INVITED stage. ID auto-generated as EMP-NNNNNNN.\nHR staff identity comes from the JWT sub claim.\n",
