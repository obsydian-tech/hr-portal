 },
 "GET /v1/verifications/{id}/summary": {
  "description": "Calls Claude (Bedrock) to produce a human-readable digest of the OCR result\nand extracted fields - no raw model output or technical field names.\n\nDesigned for downstream consumers:\n- Employee rejection notifications (why was my document not accepted)\n- WhatsApp / chatbot channels\n- Future mobile app views\n\nNumbers of six or more digits are removed from the text before it is sent to the model. Response time is typically 2-5 s.\n",
  "operationId": "getVerificationSummary",
  "parameters": [
   {
    "in": "path",
    "name": "id",
    "required": true,
    "schema": {
     "type": "string"
    }
   }
  ],
  "responses": {
   "200": {
    "content": {
     "application/json": {
      "schema": {
       "properties": {
        "summary": {
         "type": "string"
        },
        "verificationId": {
         "type": "string"
        }
       },
       "type": "object"
      }
     }
    },
    "description": "AI summary generated."
   },
   "403": {
    "description": "Only HR can check documents."
   },
   "404": {
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    },
    "description": "Verification not found."
   },
   "500": {
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    },
    "description": "Bedrock invocation failed."
