 },
 "POST /v1/employees/{employee_id}/documents/upload-url": {
  "description": "Two-step upload flow:\n1. Call this endpoint to get a short-lived pre-signed S3 PUT URL.\n2. PUT the file directly from the browser (no Authorization header on S3).\nURL expires in 300 s. Accepted: image/jpeg, image/png, application/pdf.\nKMS-encrypted with alias/naleko-onboarding-pii.\nS3 triggers processDocumentOCR Lambda automatically after upload.\n",
